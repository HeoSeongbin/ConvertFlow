{
  "name": "convertflow-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test": "vitest run --exclude \"e2e/**\"",
    "lint": "tsc --noEmit && tsc -p tsconfig.e2e.json",
    "test:e2e": "playwright test --grep-invert @queued",
    "test:e2e:queued": "playwright test --grep @queued --output test-results/queued --reporter=list",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@tanstack/react-query": "5.76.1",
    "axios": "1.20.0",
    "lucide-react": "0.511.0",
    "pdfjs-dist": "6.4.299",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/react": "19.1.4",
    "@types/react-dom": "19.1.5",
    "@vitejs/plugin-react": "4.4.1",
    "typescript": "5.8.3",
    "vite": "6.4.5",
    "vitest": "5.0.5"
  }
}
